  <data name="Control_Name" xml:space="preserve">
    <value>Activity Timeline</value>
  </data>
  <data name="Control_Description" xml:space="preserve">
    <value>A configurable timeline of activities and notes for any table, with preview, filters and activity overview.</value>
  </data>
  <data name="Anchor_Name" xml:space="preserve">
    <value>Host column</value>
  </data>
  <data name="Anchor_Description" xml:space="preserve">
    <value>Any column on the form. The timeline doesn't read or change it.</value>
  </data>
  <data name="ActivityTypes_Name" xml:space="preserve">
    <value>Activity types</value>
  </data>
  <data name="ActivityTypes_Description" xml:space="preserve">
    <value>Comma-separated logical names, e.g. email,phonecall,task,appointment,new_message. Use * for all activity types.</value>
  </data>
  <data name="IncludeNotes_Name" xml:space="preserve">
    <value>Show notes</value>
  </data>
  <data name="IncludeNotes_Description" xml:space="preserve">
    <value>Show notes and file attachments on the record, and let users write notes.</value>
  </data>
  <data name="Option_Yes" xml:space="preserve">
    <value>Yes</value>
  </data>
  <data name="Option_No" xml:space="preserve">
    <value>No</value>
  </data>
  <data name="RelatedScope_Name" xml:space="preserve">
    <value>Related activities</value>
  </data>
  <data name="RelatedScope_Description" xml:space="preserve">
    <value>Activities regarding the record only, or also activities where the record is a sender, recipient or attendee.</value>
  </data>
  <data name="RelatedScope_Regarding" xml:space="preserve">
    <value>Regarding the record</value>
  </data>
  <data name="RelatedScope_Parties" xml:space="preserve">
    <value>Regarding or participant</value>
  </data>
  <data name="SortBy_Name" xml:space="preserve">
    <value>Sort by</value>
  </data>
  <data name="SortBy_Description" xml:space="preserve">
    <value>The date the timeline is ordered and grouped by. Activity date (default) uses the date that matters per type: meetings by start, tasks and calls by due date (completed date once done), everything else by created on. A single column (e.g. Date sent) puts types without it last, as in the built-in timeline.</value>
  </data>
  <data name="SortBy_EventDate" xml:space="preserve">
    <value>Activity date (per type)</value>
  </data>
  <data name="SortBy_Created" xml:space="preserve">
    <value>Created on</value>
  </data>
  <data name="SortBy_Modified" xml:space="preserve">
    <value>Last updated (modified on)</value>
  </data>
  <data name="SortBy_ActualEnd" xml:space="preserve">
    <value>Actual end (completed)</value>
  </data>
  <data name="SortBy_DueDate" xml:space="preserve">
    <value>Due date (scheduled end)</value>
  </data>
  <data name="SortBy_StartDate" xml:space="preserve">
    <value>Start date (scheduled start)</value>
  </data>
  <data name="SortBy_SentOn" xml:space="preserve">
    <value>Date sent (emails only)</value>
  </data>
  <data name="NotesSortBy_Name" xml:space="preserve">
    <value>Sort notes by</value>
  </data>
  <data name="NotesSortBy_Description" xml:space="preserve">
    <value>The date notes are ordered by when sorting by a single column. The built-in timeline uses Last updated. By activity date, notes use Created on.</value>
  </data>
  <data name="SortOrder_Name" xml:space="preserve">
    <value>Default sort order</value>
  </data>
  <data name="SortOrder_Description" xml:space="preserve">
    <value>Newest or oldest first. Users can switch in the timeline.</value>
  </data>
  <data name="SortOrder_Desc" xml:space="preserve">
    <value>Newest first</value>
  </data>
  <data name="SortOrder_Asc" xml:space="preserve">
    <value>Oldest first</value>
  </data>
  <data name="SortBy_SortDate" xml:space="preserve">
    <value>Sort date</value>
  </data>
  <data name="CreateTypes_Name" xml:space="preserve">
    <value>Types users can create</value>
  </data>
  <data name="CreateTypes_Description" xml:space="preserve">
    <value>Comma-separated activity types in the New menu. Leave empty to hide it.</value>
  </data>
  <data name="PageSize_Name" xml:space="preserve">
    <value>Items per page</value>
  </data>
  <data name="PageSize_Description" xml:space="preserve">
    <value>How many items load at a time (5–100, default 20). Older items load as the user scrolls.</value>
  </data>
  <data name="Height_Name" xml:space="preserve">
    <value>Height (px)</value>
  </data>
  <data name="Height_Description" xml:space="preserve">
    <value>0 (default): the timeline grows with its content and the page scrolls, like the built-in timeline. A number: fixed height in pixels with its own scroll.</value>
  </data>
  <data name="Density_Name" xml:space="preserve">
    <value>Default density</value>
  </data>
  <data name="Density_Description" xml:space="preserve">
    <value>Comfortable shows previews of the content; compact shows one line per item. Users can switch.</value>
  </data>
  <data name="Density_Comfortable" xml:space="preserve">
    <value>Comfortable</value>
  </data>
  <data name="Density_Compact" xml:space="preserve">
    <value>Compact</value>
  </data>
  <data name="ShowOverview_Name" xml:space="preserve">
    <value>Show overview</value>
  </data>
  <data name="ShowOverview_Description" xml:space="preserve">
    <value>Show the summary and the activity-per-week chart above the timeline.</value>
  </data>
  <data name="ThreadEmails_Name" xml:space="preserve">
    <value>Group email conversations</value>
  </data>
  <data name="ThreadEmails_Description" xml:space="preserve">
    <value>Show replies and forwards with the same subject as one conversation.</value>
  </data>
  <data name="AdvancedConfig_Name" xml:space="preserve">
