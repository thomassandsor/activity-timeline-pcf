    <property name="anchor" display-name-key="Anchor_Name" description-key="Anchor_Description" of-type-group="anyColumn" usage="bound" required="true" />

    <property name="activityTypes" display-name-key="ActivityTypes_Name" description-key="ActivityTypes_Description" of-type="SingleLine.Text" usage="input" required="false" default-value="email,phonecall,task,appointment" />
