      <value name="modifiedon" display-name-key="SortBy_Modified">modifiedon</value>
      <value name="actualend" display-name-key="SortBy_ActualEnd">actualend</value>
      <value name="scheduledend" display-name-key="SortBy_DueDate">scheduledend</value>
      <value name="scheduledstart" display-name-key="SortBy_StartDate">scheduledstart</value>
