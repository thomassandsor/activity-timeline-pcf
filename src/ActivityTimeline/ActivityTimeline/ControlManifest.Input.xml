      <value name="modifiedon" display-name-key="SortBy_Modified">modifiedon</value>
    </property>
    <property name="sortOrder" display-name-key="SortOrder_Name" description-key="SortOrder_Description" of-type="Enum" usage="input" required="false" default-value="desc">
